{
  "manifest_version": 3,
  "name": "NoteForces",
  "short_name": "NoteForces",
  "version": "0.1.0",
  "description": "Highlight, draw and take notes on Codeforces problems. Works offline; everything stays on your computer.",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NoteForces",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.codeforces.com/problemset/problem/*",
        "*://*.codeforces.com/problemset/gymProblem/*",
        "*://*.codeforces.com/contest/*/problem/*",
        "*://*.codeforces.com/gym/*/problem/*",
        "*://*.codeforces.com/group/*/contest/*/problem/*"
      ],
      "js": [
        "src/shared/storage.js",
        "src/content/anchor.js",
        "src/content/ink.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "noteforces@addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
